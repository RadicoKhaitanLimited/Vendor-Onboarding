SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local dev - discrete vars)
DB_NAME=vendor_onboarding
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# PostgreSQL (production - single connection string, e.g. Neon).
# When set, this takes priority over the discrete DB_* vars above (see
# backend/config/settings.py). Neon requires sslmode=require.
# DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/vendor_onboarding?sslmode=require

# Set True only for quick local testing without Postgres installed.
USE_SQLITE=False

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

EMAIL_HOST_USER=your-email@radico.co.in
EMAIL_HOST_PASSWORD=your-email-password-here

DEFAULT_FROM_EMAIL=rtsm@radico.co.in
SERVER_EMAIL=rtsm@radico.co.in

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS / CSRF (comma-separated origins, no spaces, scheme+host required)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Set to true only once served over HTTPS behind a TLS-terminating reverse
# proxy (nginx, IIS, etc.) that forwards X-Forwarded-Proto/Host. Leave false
# for local dev and for plain-HTTP deployments.
DJANGO_FORCE_HTTPS=false

# Production example (GCP e2-micro VM behind nginx, Let's Encrypt via certbot,
# free sslip.io hostname - no custom domain needed):
# ALLOWED_HOSTS=34.123.45.67,34-123-45-67.sslip.io
# FRONTEND_URL=https://34-123-45-67.sslip.io
# CORS_ALLOWED_ORIGINS=https://34-123-45-67.sslip.io
# CSRF_TRUSTED_ORIGINS=https://34-123-45-67.sslip.io
# DJANGO_FORCE_HTTPS=true

# ── Required - no default, app will not start without these ──────
# Sandbox API (see apps that use SANDBOX_API_KEY/SECRET for details)
SANDBOX_API_KEY=your-sandbox-api-key
SANDBOX_API_SECRET=your-sandbox-api-secret

# Anthropic (Claude) API key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Microsoft Graph (Azure AD app registration) - used to send notification
# emails via the Graph API (apps/notifications/graph_email_service.py).
# The app registration must have Mail.Send permission with admin consent,
# and if it has an IP allowlist, the deployment server's IP must be added.
API_CLIENT_ID=your-azure-app-client-id
API_TENANT_ID=your-azure-tenant-id
API_SECRET=your-azure-app-client-secret
GRAPH_SENDER_EMAIL=rtsm@radico.co.in

